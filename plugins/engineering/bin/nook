#!/bin/sh
# The hooks of this plugin call the nook binary through this file. A plugin holds no code.
# The nook project that holds this plugin comes first, then NOOK_PROJECT, then `nook` on the PATH.
self=$(readlink -f "$0")
project=$(cd "$(dirname "$self")/../../.." 2>/dev/null && pwd)
guard=no
case "$*" in
  "hook read"|"hook bash"|"hook edit"|"eng hook bash"|"eng hook edit") guard=yes ;;
esac

# 0 and 2 are the answers of a hook; any other code means that Nook itself failed
run() {
  "$@"
  code=$?
  case $code in 0|2) exit $code ;; esac
  root=$(cd "$(dirname "$(readlink -f "$1")")/../../.." 2>/dev/null && pwd)
  if [ "$guard" = yes ]; then
    echo "nook: Nook itself failed (exit $code), so this guard blocks the call. The owner repairs the nook with a ! command, for example: ! git -C $root status, then ! git -C $root checkout -- <the broken file>" >&2
    exit 2
  fi
  echo "nook: Nook itself failed (exit $code); this hook lets the session go on" >&2
  exit 0
}

for nook in "$project/apps/nook/bin/nook" "${NOOK_PROJECT:+$NOOK_PROJECT/apps/nook/bin/nook}"; do
  [ -n "$nook" ] && [ -x "$nook" ] && run "$nook" "$@"
done
found=$(command -v nook 2>/dev/null || true)
if [ -n "$found" ] && [ "$(readlink -f "$found")" != "$self" ]; then run "$found" "$@"; fi
echo "nook: cannot find the nook binary. Link it: ln -s <nook>/apps/nook/bin/nook ~/.local/bin/nook (or set NOOK_PROJECT)" >&2
# a guard that cannot run blocks the call (exit 2); any other hook lets it pass
[ "$guard" = yes ] && exit 2
exit 1
