{
  "permissions": {
    "allow": [
      "Bash(nook eng *)",
      "Bash(git switch -c nook/*)",
      "Edit(works/**)",
      "Edit(backlog/**)",
      "Edit(docs/adr/**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(npm install*)",
      "Bash(yarn install*)",
      "Bash(pnpm install*)",
      "Bash(bun install*)",
      "Bash(pip install*)",
      "Bash(uv sync*)"
    ],
    "deny": [
      "Bash(nook eng item approve *)",
      "Bash(nook eng item accept *)",
      "Bash(nook eng item mode *)",
      "Bash(nook engineering item approve *)",
      "Bash(nook engineering item accept *)",
      "Bash(nook engineering item mode *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  }
}
