{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@nook/shared/*": ["./packages/shared/src/*"],
      "@nook/desk/*": ["./packages/desk/src/*"],
      "@nook/core/*": ["./packages/core/src/*"],
      "@nook/engineering/*": ["./packages/engineering/src/*"],
      "@nook/wiki/*": ["./packages/wiki/src/*"],
      "@nook/learn/*": ["./packages/learn/src/*"]
    }
  },
  "include": ["apps/*/src", "apps/web/e2e/*.test.ts", "apps/web/test", "packages/*/src", "packages/*/test", "scripts"]
}
