{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@kit/shared/*": ["./packages/shared/src/*"],
      "@kit/env/*": ["./packages/env/src/*"],
      "@kit/core/*": ["./packages/core/src/*"],
      "@kit/engineering/*": ["./packages/engineering/src/*"]
    }
  },
  "include": ["apps/*/src", "packages/*/src", "packages/*/test"]
}
