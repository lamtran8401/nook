{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "paths": {
      "@nook/shared/*": [
        "./packages/shared/src/*"
      ],
      "@nook/workspace/*": [
        "./packages/workspace/src/*"
      ],
      "@nook/core/*": [
        "./packages/core/src/*"
      ],
      "@nook/engineering/*": [
        "./packages/engineering/src/*"
      ],
      "@nook/wiki/*": [
        "./packages/wiki/src/*"
      ],
      "@nook/ui/*": [
        "./packages/ui/src/*"
      ],
      "@nook/issues/*": [
        "./packages/issues/src/*"
      ]
    }
  },
  "include": [
    "apps/*/src",
    "packages/*/src",
    "packages/*/test",
    "scripts"
  ],
  "exclude": [
    "packages/ui"
  ]
}
