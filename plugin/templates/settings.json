{
  "permissions": {
    "allow": [
      "Bash(nook *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --list*)",
      "Bash(rg *)",
      "Bash(nook eng *)",
      "Bash(git switch -c nook/*)",
      "Edit(works/**)",
      "Edit(backlog/**)",
      "Edit(docs/adr/**)",
      "Bash(nook wiki *)",
      "Bash(nook issues *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(docker *)",
      "Bash(npm install*)",
      "Bash(yarn install*)",
      "Bash(pnpm install*)",
      "Bash(bun install*)",
      "Bash(pip install*)",
      "Bash(uv sync*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/twg/**)",
      "Read(~/.config/gh/**)",
      "Edit(**/.env*)",
      "Edit(.nook/**)",
      "Edit(.claude/settings*.json)",
      "Bash(nook eng item approve *)",
      "Bash(nook eng item accept *)",
      "Bash(nook eng item mode *)",
      "Bash(nook engineering item approve *)",
      "Bash(nook engineering item accept *)",
      "Bash(nook engineering item mode *)"
    ]
  },
  "outputStyle": "nook-companion",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  },
  "teammateMode": "auto"
}
