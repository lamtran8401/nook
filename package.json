{
  "name": "nook",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "test": "bun test packages scripts --timeout 30000",
    "e2e": "bun test apps/web/e2e --timeout 600000",
    "pages": "bun scripts/pages/build.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
